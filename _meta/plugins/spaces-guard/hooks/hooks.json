{
  "description": "The computer's routine hooks in a cloud run: each call goes to the workspace's own guard, with the profile cloud.py begin wrote. Outside a cloud run they let everything through.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/guard.py\" bash || test \"$CLAUDE_CODE_REMOTE\" != true || exit 2",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/guard.py\" task || test \"$CLAUDE_CODE_REMOTE\" != true || exit 2",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/guard.py\" connector || test \"$CLAUDE_CODE_REMOTE\" != true || exit 2",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__.*[Ss][Ee][Nn][Dd].*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/guard.py\" send || test \"$CLAUDE_CODE_REMOTE\" != true || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
